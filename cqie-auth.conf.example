# ============================================================
# cqie-auth 配置文件模板
# ------------------------------------------------------------
# 用法：复制本文件为 cqie-auth.conf（与程序同目录，Windows）
#       或 /etc/cqie-auth.conf（Linux/OpenWrt），填写后收紧权限：
#       chmod 600 /etc/cqie-auth.conf   （文件里有明文密码，务必）
#
# 格式：key=value，# 开头为注释；等号两侧不要加空格/引号
# 优先级：命令行选项 > 环境变量 > 本文件 > 程序内置默认
# 环境变量：CQIE_USER / CQIE_PASS / CQIE_SERVICE / CQIE_CONFIG /
#           CQIE_STATE_DIR（与本文件同名键一一对应）
# ============================================================

# ------------------------------------------------------------------
# 账号（必填）
# 校园网认证账号，一般是学号或工号
# ------------------------------------------------------------------
user=20250001

# ------------------------------------------------------------------
# 密码（必填）
# 校园网认证密码（明文保存——这是文件要求权限 600 的原因）
# ------------------------------------------------------------------
password=your-password

# ------------------------------------------------------------------
# 运营商（可选）
# 必须与认证页"运营商"下拉列表里的名称**完全一致**，常见值：
#   中国移动 / 中国电信 / 校园网
#
# 留空 = 登录时按列表顺序逐个尝试（"校园网"这类限时套餐自动排最后），
#       哪个成功用哪个，并自动写回本文件，下次直接命中。
#
# 没有运营商选项的学校：保持留空即可，工具探测不到列表时会跳过该步骤。
# ------------------------------------------------------------------
service=

# ------------------------------------------------------------------
# 认证服务器地址（可选）
# 留空 = 程序内置默认 http://10.253.3.84/eportal
#
# 什么时候需要改：学校更换认证服务器；或在校园网内浏览器打开任意网页
# 被跳转到认证页时，从地址栏复制（形如 http://<portal-ip>/eportal）。
# 优先级：--portal 命令行 > portal= > 程序内置默认
# ------------------------------------------------------------------
#portal=http://10.253.3.84/eportal

# ------------------------------------------------------------------
# 探测地址（可选）
# 登录时访问这个地址来触发校园网网关的劫持跳转（提取认证参数）。
# 留空 = 程序内置默认 http://123.123.123.123（HTTP 明文 + 纯 IP，
# 网关劫持成功率最高）。
#
# 什么时候需要改：学校网络禁用了对该地址的访问导致认证页拉不出来。
# 替换原则：保持 http://（不要 https，网关无法劫持加密流量），
# 优先用纯 IP 或内网地址。
# ------------------------------------------------------------------
#probe=http://123.123.123.123
