# cqie-auth 凭据配置示例
# 复制为 /etc/cqie-auth.conf（OpenWrt/Linux）或 cqie-auth.conf（Windows）后填写，
# 并收紧权限：chmod 600 /etc/cqie-auth.conf
#
# 也可用环境变量 CQIE_USER / CQIE_PASS / CQIE_SERVICE，
# 或命令行 -u / -p / --service 临时覆盖（优先级：命令行 > 环境变量 > 本文件）。

# 学号/账号
user=263420135

# 认证密码
password=Zsh20050503_

# 运营商名（须与认证页运营商列表中的名称一致；留空则自动探测，
# 且探测成功后会自动写回本文件）
service=

# 认证服务器地址（可选；留空用编译期默认 http://10.253.3.84/eportal。
# 优先级：--portal 命令行 > portal= > 编译期默认）
#portal=http://10.253.3.84/eportal
